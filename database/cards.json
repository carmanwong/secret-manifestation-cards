    {
      "id": "SMC-021",
      "title_zh": "人生應該輕鬆不費力",
      "visible_text": "當你採取行動讓某件事發生時，會感覺很困難，好像在河中逆流而上。當你採取行動去接收時，會感覺自己順著河中的水流，輕鬆不費力。\n那就是和宇宙順流的感覺。",
      "border_colors": [
        "light_blue"
      ],
      "border_color": "light_blue",
      "source_images": [
        "source_images/06_table_blue.webp"
