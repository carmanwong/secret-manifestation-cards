    {
      "id": "SMC-008",
      "title_zh": "免於焦慮",
      "visible_text": "一切都聽從吸引力法則向你展現有意義的一切。如果你要焦慮和憂慮，你想要的事物會來嗎？那就做出這個選擇：「我總是無阻的。」",
      "border_colors": ["burgundy"],
      "border_color": "burgundy",
      "source_images": ["source_images/04_table_burgundy.webp"],
      "visibility": "clear",
      "confidence": 0.82,
      "status": "collected"
